# PayPal sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-webhook-id
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Only for local testing with the PayPal webhook simulator
PAYPAL_WEBHOOK_SKIP_VERIFY=false

# AI model. Default: Google Gemini free tier (key from https://aistudio.google.com/apikey)
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Optional paid alternative: set AI_PROVIDER=anthropic and fill these
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Neon Postgres
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Resend (test mode only delivers to the Resend account's own email)
RESEND_API_KEY=re_...
RESEND_FROM=PayPilot <onboarding@resend.dev>
DEMO_INBOX_EMAIL=you@example.com

# Sandbox personal accounts (comma separated)
SANDBOX_BUYER_EMAILS=buyer1@personal.example.com,buyer2@personal.example.com,buyer3@personal.example.com
# Only for record_demo.mjs (logs in as the buyer in the PayPal popup). Same order as the emails.
SANDBOX_BUYER_PASSWORDS=password1,password2,password3
SANDBOX_COLLAB_EMAILS=maya@personal.example.com,leo@personal.example.com

# Demo controls
DEMO_CLOCK_OFFSET_DAYS=0
DEMO_PAY_MODE=buyer
APP_URL=http://localhost:3000
